[package]
name = "ballast-recourse-smoke"
version = "0.0.0"
publish = false
edition = "2024"
rust-version = "1.96"

[dependencies]
axum = { version = "0.8.9", default-features = false }
recourse = { path = "@RECOURSE_PATH@" }
recourse-axum = { path = "@RECOURSE_AXUM_PATH@" }
schemars = "1.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
tokio = { version = "1.53.1", features = ["macros", "rt"] }
tower = { version = "0.5.3", features = ["util"] }

[patch.crates-io]
recourse = { path = "@RECOURSE_PATH@" }
