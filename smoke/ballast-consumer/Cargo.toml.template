[package]
name = "ballast-recourse-smoke"
version = "0.0.0"
publish = false
edition = "2024"
rust-version = "1.96"

[dependencies]
axum = { version = "0.8.9", default-features = false, features = ["http1", "tokio"] }
recourse = { path = "@RECOURSE_PATH@" }
recourse-axum = { path = "@RECOURSE_AXUM_PATH@" }
schemars = "1.0"
serde = { version = "1.0", features = ["derive"] }
tokio = { version = "1.53.1", features = ["macros", "net", "rt"] }

[patch.crates-io]
recourse = { path = "@RECOURSE_PATH@" }
